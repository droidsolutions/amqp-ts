{
  "name": "@droidsolutions-oss/amqp-ts",
  "version": "4.0.0",
  "description": "Easy to use AMQP library written in Typescript (using amqplib).",
  "repository": {
    "type": "git",
    "url": "git@github.com:droidsolutions/amqp-ts.git"
  },
  "keywords": [
    "amqp",
    "rabbitmq",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ab Reitsma",
  "files": [
    "lib/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf lib",
    "lint": "eslint .",
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "prepare": "husky install",
    "test": "mocha test/*.spec.ts",
    "test:integration": "mocha --config .mocharc.integration.json",
    "test:coverage": "nyc mocha test/*.spec.ts",
    "test:cjs": "node test/cjs-smoke.cjs",
    "test:release-config": "node --test test/release-config.test.mjs"
  },
  "dependencies": {
    "amqplib": "^2.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "conventional-changelog-angular": "8.2.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-n": "18.5.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "line-reader": "0.4.0",
    "merge2": "1.4.1",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "contributors": [
    {
      "email": "stefan.issmer@droidsolutions.de",
      "name": "Stefan Ißmer"
    }
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      ".nyc_output/*",
      "coverage/*",
      "lib/*",
      "test/*"
    ],
    "reporter": [
      "html",
      "text-summary"
    ],
    "all": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
